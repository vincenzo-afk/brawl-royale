# Server environment variables
PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/battle_royale
REDIS_URL=redis://:<pass>@<host>:<port>
RENDER_REGION=us-east
CLIENT_ORIGIN=http://localhost:5173

# Multi-region server URLs (optional)
RENDER_US_EAST_URL=https://your-server-us-east.onrender.com
RENDER_US_WEST_URL=https://your-server-us-west.onrender.com
RENDER_EU_WEST_URL=https://your-server-eu-west.onrender.com
RENDER_AP_SE_URL=https://your-server-ap-se.onrender.com
